    "eslint": "^10.15.0",
    "typescript-eslint": "^8.72.2",
    "gh-pages": "^6.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
